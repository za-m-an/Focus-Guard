#!/usr/bin/env python3
"""FocusGuard CLI wrapper script."""
import os
import sys

# Ensure package root is in sys.path when running from git repo
project_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if project_root not in sys.path:
    sys.path.insert(0, project_root)

from focusguard.cli.main import main

if __name__ == "__main__":
    main()
