#!/usr/bin/env python3
"""FocusGuard Daemon wrapper script."""
import os
import sys

# Resolve real path in case this script is invoked through a symlink (e.g. /usr/local/bin/focusguardd)
real_file = os.path.realpath(__file__)
project_root = os.path.dirname(os.path.dirname(real_file))
if project_root not in sys.path:
    sys.path.insert(0, project_root)

# Also ensure standard installation directory is always present
if os.path.exists("/opt/focusguard") and "/opt/focusguard" not in sys.path:
    sys.path.insert(0, "/opt/focusguard")

from focusguard.service.daemon import main

if __name__ == "__main__":
    main()
